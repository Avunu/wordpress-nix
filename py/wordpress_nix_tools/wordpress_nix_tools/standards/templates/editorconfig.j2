# PHP as WordPress and PSR-12 lay it out; everything else two spaces.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.php]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[{composer.lock,nix/vendor-hash}]
insert_final_newline = unset
# wordpress-nix:local-begin editorconfig
# wordpress-nix:local-end editorconfig
