{% import "github/workflows/_uses.j2" as w with context %}
# The site's gates (wordpress-nix docs: production/site-ci.md): `ci / flake` (the pure
# checks: composer validate, the vendor hash, the build), `ci / smoke` (a NixOS VM boots
# the package) and `ci / audit` (composer audit, wordpress.org checksums, Wordfence),
# which main requires; `ci / premium-diff` is advisory. A push to main uploads the vendor
# tree to the binary cache. wordpress-nix's reusable workflow moves only with the locked
# wordpress-nix (its rollout).
name: ci
on:
  push:
    branches: [{{ branches.integration | json_string }}]
  pull_request:
  workflow_dispatch:
permissions: {}
concurrency:
  group: {% raw %}ci-${{ github.event.pull_request.number || github.ref }}{% endraw %}

  cancel-in-progress: {% raw %}${{ github.event_name == 'pull_request' }}{% endraw %}

jobs:
  ci:
    permissions:
      contents: read
    uses: {{ w.uses("site-ci.yml") }}
    with:
      integration-branch: {{ branches.integration | json_string }}
      runs-on: {{ cfg.ci["runs-on"] | yaml_json }}
      smoke-runs-on: {{ cfg.ci["smoke-runs-on"] | yaml_json }}
      nix-cache: {{ "${{ vars." ~ cfg.ci["nix-cache-variable"] ~ " }}" }}
    secrets:
      NIX_CACHE_TOKEN: {% raw %}${{ secrets.WORDPRESS_NIX_CACHE_TOKEN }}{% endraw %}

      NIX_CACHE_READ_TOKEN: {% raw %}${{ secrets.WORDPRESS_NIX_CACHE_READ_TOKEN }}{% endraw %}

      WORDFENCE_API_KEY: {% raw %}${{ secrets.WORDFENCE_API_KEY }}{% endraw %}

