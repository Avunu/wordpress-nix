{
  "$comment": "The GitHub files of a site repository (moonshot v3 §5.4, §5.5): Dependabot, the three thin callers of wordpress-nix's reusable site workflows, pinned to the wordpress-nix revision flake.lock locks, and the site's facts.",
  "entries": [
    {
      "path": ".github/dependabot.yml",
      "template": "github/dependabot.yml.j2",
      "strategy": "whole",
      "module": "dependabot",
      "header": "yaml",
      "local_regions": ["updates"],
      "uses": ["dependabot.timezone", "dependabot.open-pull-requests-limit"]
    },
    {
      "path": ".github/workflows/ci.yml",
      "template": "github/workflows/ci.yml.j2",
      "strategy": "whole",
      "module": "ci",
      "header": "yaml",
      "uses": ["ci.runs-on", "ci.smoke-runs-on", "ci.nix-cache-variable"]
    },
    {
      "path": ".github/workflows/deps.yml",
      "template": "github/workflows/deps.yml.j2",
      "strategy": "whole",
      "module": "ci",
      "header": "yaml",
      "uses": [
        "ci.runs-on",
        "ci.github-app",
        "ci.nix-cache-variable",
        "dependabot.auto-merge",
        "dependabot.auto-merge-policy",
        "dependabot.update-branches"
      ]
    },
    {
      "path": ".github/workflows/audit.yml",
      "template": "github/workflows/audit.yml.j2",
      "strategy": "whole",
      "module": "ci",
      "header": "yaml",
      "uses": ["ci.runs-on", "ci.github-app", "ci.nix-cache-variable", "ci.schedules"]
    },
    {
      "path": ".github/wordpress-nix.json",
      "template": "github/wordpress-nix.json.j2",
      "strategy": "whole",
      "module": "site",
      "header": "none",
      "uses": ["site.home-url", "site.drop-plugins", "site.local-upload-prefixes"]
    }
  ]
}
