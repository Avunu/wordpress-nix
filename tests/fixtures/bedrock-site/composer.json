{
  "name": "avunu/bedrock-fixture",
  "type": "project",
  "license": "MIT",
  "description": "Stock Bedrock 1.31.9 with an offline package set: tests/bedrock-build.nix",
  "repositories": [
    {
      "type": "artifact",
      "url": "artifacts/"
    },
    {
      "packagist.org": false
    }
  ],
  "require": {
    "php": ">=8.3",
    "composer/installers": "^2.0",
    "fixture/greeting": "1.0.0",
    "roots/bedrock-disallow-indexing": "^2.0",
    "roots/wordpress": "7.1.5",
    "wp-plugin/fixture-plugin": "1.2.0",
    "wp-theme/fixture-theme": "1.0.0"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "composer/installers": true,
      "roots/wordpress-core-installer": true
    },
    "platform": {
      "php": "8.4"
    },
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "installer-paths": {
      "web/app/mu-plugins/{$name}/": [
        "type:wordpress-muplugin"
      ],
      "web/app/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "web/app/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    },
    "wordpress-install-dir": "web/wp"
  }
}
