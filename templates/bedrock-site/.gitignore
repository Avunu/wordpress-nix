# Application
web/app/plugins/*
!web/app/plugins/.gitkeep
# Ignore Composer-installed mu-plugin directories; single-file mu-plugins are tracked intentionally
web/app/mu-plugins/*/
web/app/themes/twentytwentyfive/
web/app/upgrade
web/app/uploads/*
!web/app/uploads/.gitkeep
web/app/cache/*

# WordPress
web/wp
web/.htaccess

# Logs
*.log

# Dotenv
.env
.env.*
!.env.example

# Composer
/vendor
auth.json

# PHPUnit/Pest
phpunit.xml
.phpunit.result.cache
.phpunit.cache

# WP-CLI
wp-cli.local.yml

# Nix
result
result-*
.direnv/
.devenv/

# wordpress-nix: the platform mu-plugins the dev shell copies in (the build
# injects its own)
web/app/mu-plugins/platform-*.php

# BEGIN wordpress-nix (managed): committed premium and custom code, one line each
# !web/app/plugins/<slug>
# END wordpress-nix

# >>> wordpress-nix: site (managed) >>>
# Never committed (site-ci's ci / flake refuses dumps, auth.json and .env)
auth.json
.env
.env.*
!.env.example
*.sql
*.sql.gz
# Built by Composer and the site flake, never committed
/vendor
web/wp
web/app/uploads/*
!web/app/uploads/.gitkeep
# <<< wordpress-nix: site (managed) <<<
