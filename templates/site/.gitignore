# --- Platform (build artifacts and generated files) ---
/public
/.worker
/.wrangler/
/.dev.vars
/result
/result-*
/.direnv/
/.devenv/
/.devenv.flake.nix
node_modules/

# Local secrets for the dev shell (S3_KEY, JWT_AUTH_CLIENT_SECRET, ...).
.env
.env.*
!.env.example

# Platform-injected files: never committed, refreshed by the platform.
wp-content/mu-plugins/platform-*.php
wp-content/db.php
wp-content/object-cache.php
wp-content/advanced-cache.php
# gitium versions the site but is not part of it: the platform reinstalls it on
# every start, and without this line gitium would commit itself on first sweep.
wp-content/plugins/gitium/

# --- WordPress core (symlinked/baked; the platform pin owns it) ---
/wp-admin/
/wp-includes/
/index.php
/wp-*.php
/xmlrpc.php
/license.txt
/readme.html
wp-config.php

# --- Volatile site state (gitium also ignores these) ---
wp-content/uploads/
wp-content/upgrade/
wp-content/upgrade-temp-backup/
wp-content/cache/
wp-content/backup-db/
wp-content/backups/
wp-content/blogs.dir/
*.log
# Debris from working on a server over SSH.
*_history
.rnd
.wget-hsts
*.sql
*.sql.gz
*.sqlite
.htaccess
.maintenance
sitemap.xml
sitemap.xml.gz
